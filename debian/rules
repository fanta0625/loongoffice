#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

SHELL := /bin/bash

export LC_ALL := C.UTF-8
export DEB_BUILD_MAINT_OPTIONS := hardening=+all

MAINPKG := loongoffice
PKGDIR := $(CURDIR)/debian/$(MAINPKG)
OFFICE_HOME := /opt/loongoffice

OFD_SOURCE ?= $(CURDIR)/vendor/libreoffice-ofd-extension
OFDRW_SOURCE ?= $(CURDIR)/vendor/ofdrw
BATCH_PRINT_SOURCE ?= $(CURDIR)/vendor/libreoffice-batch-print
LO_TARBALLS ?= $(CURDIR)/vendor/libreoffice-tarballs

# The seed repository is prepared on a connected machine. Builds only use the
# private copy under debian/, so the source-supplied repository stays unchanged.
MAVEN_SEED_REPO ?= $(CURDIR)/vendor/maven-repository
MAVEN_BUILD_REPO := $(CURDIR)/debian/.m2/repository
SOURCE_DATE_EPOCH ?= $(shell dpkg-parsechangelog -STimestamp)
MAVEN := mvn --batch-mode --no-transfer-progress --offline \
	-Dmaven.repo.local=$(MAVEN_BUILD_REPO) \
	-Dproject.build.outputTimestamp=$(SOURCE_DATE_EPOCH) \
	-Dgpg.skip=true

OFD_OXT := $(OFD_SOURCE)/target/loongoffice-ofd-extension.oxt

export PATH := /usr/lib/gcc-loongarch64-linux-gnu:$(PATH)

%:
	dh $@

# LibreOffice owns its bootstrap process. Generic dh_autoreconf cannot process
# this source tree; autogen.sh is invoked by override_dh_auto_configure below.
override_dh_autoreconf:
	@:

override_dh_autoreconf_clean:
	@:

override_dh_auto_configure:
	debian/scripts/check-vendor-sources "$(MAVEN_SEED_REPO)"
	rm -rf "$(MAVEN_BUILD_REPO)"
	install -d "$(MAVEN_BUILD_REPO)"
	cp -a "$(MAVEN_SEED_REPO)/." "$(MAVEN_BUILD_REPO)/"
	debian/scripts/configure-libreoffice "$(LO_TARBALLS)"
	debian/scripts/check-libreoffice-tarballs "$(LO_TARBALLS)"

override_dh_auto_build:
	$(MAVEN) -f "$(OFDRW_SOURCE)/pom.xml" \
		-Dmaven.test.skip=true -Dmaven.javadoc.skip=true install
	$(MAVEN) -f "$(OFD_SOURCE)/pom.xml" \
		-Dmaven.test.skip=true -Ploongoffice clean package
	test -s "$(OFD_OXT)"
	$(MAKE) build

override_dh_auto_install:
	rm -rf "$(PKGDIR)"
	install -d "$(PKGDIR)"
	DESTDIR="$(PKGDIR)" $(MAKE) distro-pack-install
	find "$(PKGDIR)" -maxdepth 1 -type f -name 'gid_Module_*' -delete
	debian/scripts/install-custom-components \
		"$(PKGDIR)" "$(OFD_OXT)" "$(BATCH_PRINT_SOURCE)"
	debian/scripts/isolate-loongoffice-installation "$(PKGDIR)"

override_dh_auto_clean:
	if [ -f Makefile ]; then $(MAKE) clean; fi
	rm -rf "$(OFD_SOURCE)/target" "$(MAVEN_BUILD_REPO)"
	if [ -d "$(OFDRW_SOURCE)" ]; then \
		find "$(OFDRW_SOURCE)" -type d -name target -prune -exec rm -rf '{}' +; \
	fi

# Resolve LoongOffice's private libraries while still generating dependencies
# for system libraries. Keeping ${shlibs:Depends} is safer than skipping this
# step for an all-in-one package.
override_dh_shlibdeps:
	dh_shlibdeps -p$(MAINPKG) \
		-l$(PKGDIR)$(OFFICE_HOME)/program \
		-l$(PKGDIR)$(OFFICE_HOME)/program/ure/lib

# dwz only deduplicates DWARF data.  The Loongnix dwz tool cannot process the
# full set of large, private LibreOffice ELF objects installed below /opt, so
# do not let an optional debug-information optimization fail the package.
override_dh_dwz:
	@:

override_dh_compress:
	dh_compress -X.py -X.oxt -X.rdb -X.xcu -X.xcs
