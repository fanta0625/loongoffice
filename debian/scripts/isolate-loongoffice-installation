#!/bin/sh

set -eu

destdir=${1:?missing DESTDIR}
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
office_home=/opt/loongoffice
bindir="$destdir/usr/bin"
mandir="$destdir/usr/share/man/man1"
completion_dir="$destdir/usr/share/bash-completion/completions"
metainfo_dir="$destdir/usr/share/metainfo"
profile="$destdir$office_home/program/bootstraprc"

case "$destdir" in
    ""|/)
        echo "ERROR: refusing unsafe DESTDIR: $destdir" >&2
        exit 1
        ;;
esac

# distro-pack-install assumes that this build provides the system LibreOffice.
# Keep only LoongOffice-branded entry points so both products can be installed.
generic_commands='libreoffice soffice loffice lobase localc lodraw lomath
loimpress loweb lowriter lofromtemplate unopkg ooffice oobase oocalc oodraw
ooimpress oomath ooweb oowriter oofromtemplate'

for command in $generic_commands; do
    rm -f "$bindir/$command"
    rm -f "$mandir/$command.1" "$mandir/$command.1.gz"
done
rm -f "$completion_dir/ooffice.sh" "$completion_dir/loongoffice.sh"

# The upstream completion generated by distro-pack-install still registers the
# generic LibreOffice wrappers. Generate one for the branded command only.
install -d "$completion_dir"
/usr/bin/python3 "$root/bin/generate-bash-completion.py" \
    --office loongoffice \
    --office_short '' \
    --master '' \
    --base '' \
    --calc '' \
    --draw '' \
    --impress '' \
    --math '' \
    --template '' \
    --unopkg '' \
    --web '' \
    --writer '' \
    "$root/bin/bash-completion.in" "$completion_dir/loongoffice"
sed -i 's/_loexp_/_loongoffice_exp_/g' "$completion_dir/loongoffice"
chmod 0644 "$completion_dir/loongoffice"

# create_tree.sh brands the metadata filenames, but its source XML still uses
# LibreOffice component IDs. Duplicate IDs confuse AppStream when both suites
# are installed, so make the staged component IDs match their desktop files.
for app in base calc draw impress writer; do
    metadata="$metainfo_dir/loongoffice-$app.appdata.xml"
    if [ ! -f "$metadata" ]; then
        echo "ERROR: staged LoongOffice AppStream metadata is missing: $metadata" >&2
        exit 1
    fi
    sed -i \
        -e "s/libreoffice-$app\.desktop/loongoffice-$app.desktop/g" \
        -e 's/LibreOffice/LoongOffice/g' \
        "$metadata"
    grep -Fqx "  <id>loongoffice-$app.desktop</id>" "$metadata"
    xmllint --noout "$metadata"
done

kde_metadata="$metainfo_dir/org.loongoffice.kde.metainfo.xml"
if [ ! -f "$kde_metadata" ]; then
    echo "ERROR: staged LoongOffice KDE metadata is missing: $kde_metadata" >&2
    exit 1
fi
sed -i \
    -e 's/org\.libreoffice\.kde/org.loongoffice.kde/g' \
    -e 's/libreoffice-/loongoffice-/g' \
    -e 's/LibreOffice/LoongOffice/g' \
    "$kde_metadata"
grep -Fqx '  <id>org.loongoffice.kde</id>' "$kde_metadata"
xmllint --noout "$kde_metadata"

if [ ! -x "$destdir$office_home/program/soffice" ]; then
    echo "ERROR: staged LoongOffice executable is missing." >&2
    exit 1
fi
if [ ! -L "$bindir/loongoffice" ] || \
   [ "$(readlink "$bindir/loongoffice")" != "$office_home/program/soffice" ]; then
    echo "ERROR: /usr/bin/loongoffice is not the expected branded symlink." >&2
    exit 1
fi
if [ ! -f "$profile" ] || \
   ! grep -Fqx 'UserInstallation=$SYSUSERCONFIG/loongoffice/4' "$profile"; then
    echo "ERROR: LoongOffice does not have an isolated user profile." >&2
    exit 1
fi

for command in $generic_commands; do
    if [ -e "$bindir/$command" ] || [ -L "$bindir/$command" ]; then
        echo "ERROR: unbranded command remains in the package: /usr/bin/$command" >&2
        exit 1
    fi
done

if grep -Eq '(^|[^[:alnum:]_])(libreoffice|loffice|lobase|localc|lodraw|lomath|loimpress|loweb|lowriter|lofromtemplate|unopkg|ooffice)([^[:alnum:]_]|$)' \
    "$completion_dir/loongoffice"; then
    echo "ERROR: branded completion still registers a generic command." >&2
    exit 1
fi
