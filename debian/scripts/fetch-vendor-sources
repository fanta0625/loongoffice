#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/debian/vendor-sources.lock"

fetch_source()
{
    name=$1
    url=$2
    commit=$3
    path=$4

    if [ ! -e "$path/.git" ]; then
        if [ -e "$path" ]; then
            echo "ERROR: $path exists but is not a Git checkout" >&2
            exit 1
        fi
        git clone --no-checkout "$url" "$path"
    fi

    git -C "$path" fetch --no-tags origin "$commit"
    git -C "$path" checkout --detach "$commit"
    echo "$name is locked at $commit"
}

fetch_submodule()
{
    name=$1
    path=$2
    url=$3
    commit=$4

    gitlink=$(git -C "$root" ls-tree HEAD -- "$path" | awk '$1 == "160000" { print $3 }')
    if [ "$gitlink" != "$commit" ]; then
        echo "ERROR: $path gitlink is $gitlink; expected $commit" >&2
        exit 1
    fi

    existing_tree=
    if [ ! -e "$root/$path/.git" ]; then
        if [ -f "$root/$path/.source-commit" ]; then
            actual=$(sed -n '1p' "$root/$path/.source-commit")
            if [ "$actual" != "$commit" ]; then
                echo "ERROR: $path source marker is $actual; expected $commit" >&2
                exit 1
            fi
            echo "$name is locked at $commit"
            return
        fi
        if [ -d "$root/$path" ] && \
           [ -n "$(find "$root/$path" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
            existing_tree=yes
        fi
        mkdir -p "$root/$path"
        git init -q "$root/$path"
    fi

    if git -C "$root/$path" remote get-url origin >/dev/null 2>&1; then
        git -C "$root/$path" remote set-url origin "$url"
    else
        git -C "$root/$path" remote add origin "$url"
    fi
    git -C "$root/$path" fetch --no-tags --depth 1 origin "$commit"

    if [ "$existing_tree" = yes ]; then
        temporary_index=$(mktemp)
        rm -f "$temporary_index"
        GIT_INDEX_FILE="$temporary_index" \
            git -C "$root/$path" add -A -f .
        actual_tree=$(GIT_INDEX_FILE="$temporary_index" \
            git -C "$root/$path" write-tree)
        rm -f "$temporary_index"
        expected_tree=$(git -C "$root/$path" rev-parse "$commit^{tree}")
        if [ "$actual_tree" != "$expected_tree" ]; then
            echo "ERROR: existing $path source does not match $commit" >&2
            echo "Move the unverified directory aside and run this script again." >&2
            exit 1
        fi
        git -C "$root/$path" reset --hard "$commit"
    fi

    git -C "$root/$path" checkout --detach "$commit"
    if ! git -C "$root/$path" diff --quiet "$commit" -- || \
       [ -n "$(git -C "$root/$path" clean -ndx)" ]; then
        echo "ERROR: $path contains changes outside locked commit $commit" >&2
        exit 1
    fi
    echo "$name is locked at $commit"
}

mkdir -p "$root/vendor"
fetch_submodule "LibreOffice dictionaries" dictionaries \
    "$LO_DICTIONARIES_URL" "$LO_DICTIONARIES_COMMIT"
fetch_submodule "LibreOffice help" helpcontent2 \
    "$LO_HELP_URL" "$LO_HELP_COMMIT"
fetch_submodule "LibreOffice translations" translations \
    "$LO_TRANSLATIONS_URL" "$LO_TRANSLATIONS_COMMIT"
fetch_source "batch print" "$BATCH_PRINT_URL" "$BATCH_PRINT_COMMIT" \
    "$root/vendor/libreoffice-batch-print"

"$root/debian/scripts/check-vendor-sources"
