#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/debian/vendor-sources.lock"

repository=${1:-"$root/vendor/maven-repository"}

case "$repository" in
    ""|/|"$root"|"$root/vendor")
        echo "ERROR: refusing unsafe Maven repository path: $repository" >&2
        exit 1
        ;;
esac

"$root/debian/scripts/check-vendor-sources" "$repository" --skip-maven
mkdir -p "$repository"

run_maven()
{
    mvn --batch-mode --no-transfer-progress \
        "-Dmaven.repo.local=$repository" -Dgpg.skip=true "$@"
}

run_maven -f "$root/vendor/ofdrw/pom.xml" \
    -Dmaven.test.skip=true -Dmaven.javadoc.skip=true clean install
run_maven -f "$root/vendor/libreoffice-ofd-extension/pom.xml" \
    -Dmaven.test.skip=true -Ploongoffice clean package

# Verify that the exact build works without any network access.
run_maven --offline -f "$root/vendor/ofdrw/pom.xml" \
    -Dmaven.test.skip=true -Dmaven.javadoc.skip=true clean install
run_maven --offline -f "$root/vendor/libreoffice-ofd-extension/pom.xml" \
    -Dmaven.test.skip=true -Ploongoffice clean package

cat > "$repository/.loongoffice-offline-repository" <<EOF
ofd=$OFD_COMMIT
ofdrw=$OFDRW_COMMIT
EOF

echo "Offline Maven repository prepared at $repository"
