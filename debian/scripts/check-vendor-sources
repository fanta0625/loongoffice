#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/debian/vendor-sources.lock"

maven_repository=${1:-"$root/vendor/maven-repository"}
skip_maven=${2:-}

check_source()
{
    name=$1
    path=$2
    expected=$3
    required_file=$4

    if [ ! -f "$path/$required_file" ]; then
        echo "ERROR: $name source is missing at $path" >&2
        echo "Fetch locked sources or overlay the exported vendor source bundle." >&2
        exit 1
    fi

    if [ -e "$path/.git" ]; then
        actual=$(git -C "$path" rev-parse HEAD)
    elif [ -f "$path/.source-commit" ]; then
        actual=$(sed -n '1p' "$path/.source-commit")
    else
        echo "ERROR: $name has no .git metadata or .source-commit marker." >&2
        exit 1
    fi

    if [ "$actual" != "$expected" ]; then
        echo "ERROR: $name is at $actual; expected $expected" >&2
        exit 1
    fi
}

check_source "OFD extension" \
    "$root/vendor/libreoffice-ofd-extension" "$OFD_COMMIT" pom.xml
check_source "batch print" \
    "$root/vendor/libreoffice-batch-print" "$BATCH_PRINT_COMMIT" main.py
check_source "OFDRW" \
    "$root/vendor/ofdrw" "$OFDRW_COMMIT" pom.xml

if [ "$skip_maven" != "--skip-maven" ]; then
    marker="$maven_repository/.loongoffice-offline-repository"
    if [ ! -f "$marker" ]; then
        echo "ERROR: offline Maven repository is not prepared: $maven_repository" >&2
        echo "Run debian/scripts/prepare-offline-maven-repository on a connected host." >&2
        exit 1
    fi

    if ! grep -qx "ofd=$OFD_COMMIT" "$marker" || \
       ! grep -qx "ofdrw=$OFDRW_COMMIT" "$marker"; then
        echo "ERROR: offline Maven repository does not match vendor-sources.lock" >&2
        exit 1
    fi
fi

echo "Vendor sources and offline inputs are consistent."
