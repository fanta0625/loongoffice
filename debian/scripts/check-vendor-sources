#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/debian/vendor-sources.lock"

check_source()
{
    name=$1
    path=$2
    expected=$3
    required_file=$4

    if [ ! -e "$path/$required_file" ]; then
        echo "ERROR: $name source is missing at $path" >&2
        echo "Fetch locked sources or overlay the exported offline source bundle." >&2
        exit 1
    fi

    if [ -e "$path/.git" ]; then
        if ! actual=$(git -C "$path" rev-parse HEAD 2>/dev/null); then
            echo "ERROR: $name Git checkout has no valid HEAD at $path" >&2
            echo "Move the incomplete directory aside and fetch it again." >&2
            exit 1
        fi
    elif [ -f "$path/.source-commit" ]; then
        actual=$(sed -n '1p' "$path/.source-commit")
    else
        echo "ERROR: $name has no .git metadata or .source-commit marker." >&2
        exit 1
    fi

    if [ "$actual" != "$expected" ]; then
        echo "ERROR: $name is at $actual; expected $expected" >&2
        exit 1
    fi
}

check_gitlink()
{
    path=$1
    expected=$2

    if [ -e "$root/.git" ] && \
       git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
        actual=$(git -C "$root" ls-tree HEAD -- "$path" | \
            awk '$1 == "160000" { print $3 }')
        if [ "$actual" != "$expected" ]; then
            echo "ERROR: $path gitlink is $actual; expected $expected" >&2
            exit 1
        fi
    fi
}

check_gitlink helpcontent2 "$LO_HELP_COMMIT"
check_gitlink translations "$LO_TRANSLATIONS_COMMIT"
check_source "LibreOffice help" \
    "$root/helpcontent2" "$LO_HELP_COMMIT" Module_helpcontent2.mk
check_source "LibreOffice translations" \
    "$root/translations" "$LO_TRANSLATIONS_COMMIT" source/zh-CN

check_source "batch print" \
    "$root/vendor/libreoffice-batch-print" "$BATCH_PRINT_COMMIT" main.py

echo "Vendor sources are consistent."
