#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
url=https://github.com/fanta0625/libreoffice-ofd-extension/releases/download/v1.1.0/ofd-extension.oxt
input=${1:-}
destination="$root/debian/prebuilt/ofd-extension.oxt"
checksum="$destination.sha256"
temporary_dir=$(mktemp -d)
temporary_checksum="$temporary_dir/sha256"
trap 'rm -rf "$temporary_dir"' EXIT HUP INT TERM

# Download only during connected preparation, never during a package build.
if [ -z "$input" ]; then
    input="$temporary_dir/ofd-extension.oxt"
    if command -v gh >/dev/null 2>&1; then
        gh release download v1.1.0 \
            --repo fanta0625/libreoffice-ofd-extension \
            --pattern ofd-extension.oxt --dir "$temporary_dir"
    elif command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 --connect-timeout 20 -o "$input" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$input" "$url"
    else
        echo "ERROR: gh, curl or wget is required to download the OFD OXT." >&2
        exit 1
    fi
fi

[ -s "$input" ] || {
    echo "ERROR: OFD OXT artifact is missing or empty: $input" >&2
    exit 1
}

digest=$(sha256sum "$input" | awk '{print $1}')
printf '%s\n' "$digest" > "$temporary_checksum"
"$root/debian/scripts/check-ofd-oxt" "$input" "$temporary_checksum"

install -d "$(dirname "$destination")"
install -m 0644 "$input" "$destination"
printf '%s\n' "$digest" > "$checksum"

echo "Imported prebuilt OFD OXT: $destination"
echo "Add the OXT and checksum to the source-package commit."
